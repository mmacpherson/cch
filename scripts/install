#!/usr/bin/env bash
# Install the cch launcher + cch-eval dev shim into a chosen bin directory.
#
# cch runs from the self-contained jlink runtime (bundled JRE + uberjar) under
# ~/.local/share/cch/runtime. Every cch process — `serve`, `control runner`,
# `control mcp`, `control broker` — is the same artifact, chosen by subcommand.
# The launcher is a thin exec wrapper around that runtime, so nothing depends on
# the location of this repo checkout (no repo symlink, no `clj` on the hot path).
#
# Usage: scripts/install [bin-dir]   (default: ~/.local/bin)
set -euo pipefail

bin="${1:-$HOME/.local/bin}"
bin="${bin/#\~/$HOME}"
repo="$(cd "$(dirname "$0")/.." && pwd)"
share="$HOME/.local/share/cch"
runtime_dst="$share/runtime"
runtime_bin="$runtime_dst/bin/cch"

mkdir -p "$bin" "$share"

# Runtime: deploy the jlink'd image built by `just build`.
#
# Each install lands in a fresh versioned directory under runtimes/, and
# `runtime` is a symlink swapped to it with one atomic rename. A running JVM
# never has its own JRE files replaced underneath it: replacing them in place
# breaks its ability to start child processes (posix_spawn fails) until it
# restarts. The launcher resolves its real directory, so each JVM keeps
# using the version it started from. The newest few versions are kept, so
# processes not restarted below (per-session `cch control mcp`) keep theirs.
runtime_src="$repo/target/cch-runtime"
if [[ ! -d "$runtime_src" ]]; then
  echo "Error: runtime image not found at $runtime_src" >&2
  echo "Build it first:  just build" >&2
  exit 1
fi
runtimes="$share/runtimes"
keep_runtimes=3
version="$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir -p "$runtimes"
rsync -a "$runtime_src/" "$runtimes/.$version.partial/"
mv "$runtimes/.$version.partial" "$runtimes/$version"

# rename(2) replaces the symlink atomically and, unlike `mv`, never descends
# into the directory an existing symlink points at (GNU and BSD alike).
atomic_rename() { perl -e 'rename($ARGV[0], $ARGV[1]) or die "rename: $!\n"' "$1" "$2"; }

if [[ -d "$runtime_dst" && ! -L "$runtime_dst" ]]; then
  # One-time migration from the old in-place directory.
  mv "$runtime_dst" "$runtimes/00000000T000000Z-legacy"
fi
ln -s "runtimes/$version" "$share/.runtime.$$"
atomic_rename "$share/.runtime.$$" "$runtime_dst"
echo "  $runtime_dst -> runtimes/$version  (deployed from target/cch-runtime)"

# Prune: keep the newest $keep_runtimes versions, never the current one, and
# never one a running process still uses. The launcher execs the real
# versioned path, so a process using a version names it on its command line.
# The legacy directory's processes name the unversioned runtime path instead.
running="$(ps -axww -o command= 2>/dev/null || true)"
in_use() {
  local dir="$1"
  if [[ "$(basename "$dir")" == *-legacy ]]; then
    [[ "$running" == *"$runtime_dst/"* ]]
  else
    [[ "$running" == *"$dir/"* ]]
  fi
}
old_versions=()
while IFS= read -r dir; do old_versions+=("$dir"); done \
  < <(find "$runtimes" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sort)
prune_count=$(( ${#old_versions[@]} - keep_runtimes ))
for (( i = 0; i < prune_count; i++ )); do
  dir="${old_versions[i]}"
  [[ "$(basename "$dir")" == "$version" ]] && continue
  if in_use "$dir"; then
    echo "  kept $(basename "$dir"): still in use by a running process"
    continue
  fi
  rm -rf "$dir"
done
find "$runtimes" -mindepth 1 -maxdepth 1 -name '.*.partial' -type d -mmin +60 -exec rm -rf {} + 2>/dev/null || true

# cch — thin launcher that execs the bundled runtime. NOT a symlink: the runtime
# launcher locates its JRE and uberjar relative to its own real path, so it must
# be invoked where it actually lives.
cat > "$bin/cch" <<EOF
#!/usr/bin/env bash
exec "$runtime_bin" "\$@"
EOF
chmod +x "$bin/cch"

# cch-eval — dev-only eval helper; symlink so repo edits flow through. It is not
# on any service's critical path, so a stale link never affects the control plane.
ln -sf "$repo/bin/cch-eval" "$bin/cch-eval"

# statusline-command.sh — copy to ~/.claude so Claude Code picks it up.
mkdir -p "$HOME/.claude"
cp "$repo/bin/statusline-command.sh" "$HOME/.claude/statusline-command.sh"
chmod +x "$HOME/.claude/statusline-command.sh"

# cch-usage-glyph.sh — one-cell usage meter for a tmux status line.
install -m 755 "$repo/bin/cch-usage-glyph.sh" "$bin/cch-usage-glyph.sh"

# Restart cch-owned services so they run the freshly deployed runtime. Every
# long-lived cch process is the same jlink image chosen by subcommand, so a
# redeploy that only restarts the dispatcher would leave the paired runner (and
# any broker) executing the OLD jar. Bounce each unit that is actually active.
if [[ "$(uname -s)" == "Darwin" ]]; then
  # launchd: kickstart -k restarts a loaded job in place, avoiding the
  # bootout/bootstrap race that can leave a job unloaded.
  domain="gui/$(id -u)"
  for label in com.cch.server com.cch.control-runner; do
    if launchctl print "$domain/$label" &>/dev/null; then
      launchctl kickstart -k "$domain/$label"
      echo "  $label restarted"
    fi
  done
else
  for unit in cch.service cch-control-runner.service cch-control-broker.service; do
    if systemctl --user is-active "$unit" &>/dev/null; then
      systemctl --user restart "$unit"
      echo "  ${unit%.service} restarted"
    fi
  done
fi

# Per-session MCP subprocesses are spawned by the provider CLIs, not by systemd,
# so a redeploy cannot bounce them. Point the operator at the refresh path.
echo
echo "Active agent sessions keep their previous cch MCP until refreshed:"
echo "    Codex:  cch control refresh-mcp codex"
echo "    Claude: run '/mcp reconnect cch' inside each active session"

echo
echo "Installed:"
echo "  $bin/cch        -> execs $runtime_bin"
echo "  $bin/cch-eval   -> $repo/bin/cch-eval"
echo "  ~/.claude/statusline-command.sh  (copied)"
echo "  $bin/cch-usage-glyph.sh  (copied)"

if ! command -v cch >/dev/null 2>&1; then
  echo
  echo "⚠  $bin is not on your PATH. Add to your shell rc:"
  echo "    export PATH=\"$bin:\$PATH\""
fi
