#!/usr/bin/env bash
# Install the cch launcher + cch-eval dev shim into a chosen bin directory.
#
# cch runs from the self-contained jlink runtime (bundled JRE + uberjar) under
# ~/.local/share/cch/runtime. Every cch process — `serve`, `control runner`,
# `control mcp`, `control broker` — is the same artifact, chosen by subcommand.
# The launcher is a thin exec wrapper around that runtime, so nothing depends on
# the location of this repo checkout (no repo symlink, no `clj` on the hot path).
#
# Usage: scripts/install [bin-dir]   (default: ~/.local/bin)
set -euo pipefail

bin="${1:-$HOME/.local/bin}"
bin="${bin/#\~/$HOME}"
repo="$(cd "$(dirname "$0")/.." && pwd)"
share="$HOME/.local/share/cch"
runtime_dst="$share/runtime"
runtime_bin="$runtime_dst/bin/cch"

mkdir -p "$bin" "$share"

# Runtime: deploy the jlink'd image built by `just build`.
runtime_src="$repo/target/cch-runtime"
if [[ ! -d "$runtime_src" ]]; then
  echo "Error: runtime image not found at $runtime_src" >&2
  echo "Build it first:  just build" >&2
  exit 1
fi
rsync -a --delete "$runtime_src/" "$runtime_dst/"
echo "  $runtime_dst  (deployed from target/cch-runtime)"

# cch — thin launcher that execs the bundled runtime. NOT a symlink: the runtime
# launcher locates its JRE and uberjar relative to its own real path, so it must
# be invoked where it actually lives.
cat > "$bin/cch" <<EOF
#!/usr/bin/env bash
exec "$runtime_bin" "\$@"
EOF
chmod +x "$bin/cch"

# cch-eval — dev-only eval helper; symlink so repo edits flow through. It is not
# on any service's critical path, so a stale link never affects the control plane.
ln -sf "$repo/bin/cch-eval" "$bin/cch-eval"

# statusline-command.sh — copy to ~/.claude so Claude Code picks it up.
mkdir -p "$HOME/.claude"
cp "$repo/bin/statusline-command.sh" "$HOME/.claude/statusline-command.sh"
chmod +x "$HOME/.claude/statusline-command.sh"

# Restart the local dispatcher so it runs the freshly deployed runtime.
if systemctl --user is-active cch.service &>/dev/null; then
  systemctl --user restart cch.service
  echo "  cch.service restarted"
fi

echo "Installed:"
echo "  $bin/cch        -> execs $runtime_bin"
echo "  $bin/cch-eval   -> $repo/bin/cch-eval"
echo "  ~/.claude/statusline-command.sh  (copied)"

if ! command -v cch >/dev/null 2>&1; then
  echo
  echo "⚠  $bin is not on your PATH. Add to your shell rc:"
  echo "    export PATH=\"$bin:\$PATH\""
fi
