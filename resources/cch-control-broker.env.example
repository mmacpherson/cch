# cch control broker — environment configuration
#
# Copy to ~/.config/cch-control-broker.env (referenced by the systemd unit and
# the Quadlet), fill in real values, and keep it out of version control.
# `cch control broker` reads all configuration from these variables.

# --- Runner authentication (required) -------------------------------------
# Comma-separated runner-id:token pairs the broker will accept. Each paired
# runner presents its token; tokens are bearer secrets, so treat this like a
# password file.
CCH_CONTROL_RUNNER_TOKENS=runner-a:CHANGE_ME_TOKEN_A,runner-b:CHANGE_ME_TOKEN_B

# --- Postgres route directory + message metadata (recommended) ------------
# Omit the whole DATABASE block to run with a disposable in-memory directory
# (fine for a smoke test; loses all routes/leases on restart).
CCH_CONTROL_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/cch_control
CCH_CONTROL_DATABASE_USER=cch_control
CCH_CONTROL_DATABASE_PASSWORD=CHANGE_ME
CCH_CONTROL_DATABASE_SCHEMA=public
CCH_CONTROL_DATABASE_POOL_SIZE=8

# --- Human switchboard web UI (optional) ----------------------------------
# Leave the WEB block unset to disable the switchboard. When set, it listens
# on its own host/port and authenticates via Cloudflare Access.
#CCH_CONTROL_WEB_HOST=127.0.0.1
#CCH_CONTROL_WEB_PORT=8788
#CCH_CONTROL_WEB_ORIGIN=https://cch.example.com
#CCH_CONTROL_WEB_SESSION_SECRET=CHANGE_ME_LONG_RANDOM
#CCH_CONTROL_WEB_ALLOWED_EMAILS=you@example.com
#CCH_CONTROL_CLOUDFLARE_ISSUER=https://example.cloudflareaccess.com
#CCH_CONTROL_CLOUDFLARE_AUDIENCE=CHANGE_ME_AUD_TAG
