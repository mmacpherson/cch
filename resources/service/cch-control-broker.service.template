[Unit]
Description=cch private multi-agent control broker
Documentation=https://github.com/mmacpherson/cch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Postgres, runner tokens, and the optional web switchboard are supplied here.
# Copy resources/cch-control-broker.env.example and fill it in.
EnvironmentFile=%h/.config/cch-control-broker.env
ExecStart=%h/.local/share/cch/runtime/bin/cch control broker --host {{HOST}} --port {{PORT}}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
