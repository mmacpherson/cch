[Unit]
Description=cch HTTP dispatcher + dashboard
Documentation=https://github.com/mmacpherson/cch
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/cch
ExecStart=%h/.local/share/cch/runtime/bin/cch serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
