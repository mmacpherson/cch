# Podman Quadlet for the cch control broker (containerized deploy path).
#
# Install to ~/.config/containers/systemd/cch-control-broker.container, then
# `systemctl --user daemon-reload && systemctl --user start cch-control-broker`.
# Pin Image to a tag your build+ship step produces (e.g. cch-control:<git-sha>);
# environment-specific wrappers own the registry/tag story.

[Unit]
Description=cch private multi-agent control broker (container)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/cch-control:latest
# ENTRYPOINT is `java -jar /app/cch.jar`; Exec supplies the broker subcommand.
Exec=control broker --host 0.0.0.0 --port 8787
EnvironmentFile=%h/.config/cch-control-broker.env
PublishPort=127.0.0.1:8787:8787
# Uncomment when the web switchboard is configured (CCH_CONTROL_WEB_PORT):
#PublishPort=127.0.0.1:8788:8788
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8787/health
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s

[Service]
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
